{
  "buildCommand": "cd app && npm install && npm run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    { "source": "/auth", "destination": "/app.html" },
    { "source": "/onboarding", "destination": "/app.html" },
    { "source": "/social", "destination": "/app.html" },
    { "source": "/profile", "destination": "/app.html" },
    { "source": "/settings", "destination": "/app.html" },
    { "source": "/subscribe", "destination": "/app.html" },
    { "source": "/notifications", "destination": "/app.html" },
    { "source": "/coach", "destination": "/app.html" },
    { "source": "/progress", "destination": "/app.html" },
    { "source": "/workout/(.*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
